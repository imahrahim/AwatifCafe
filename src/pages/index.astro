---
import WaterTaxi from "../components/sections/WaterTaxi.astro";
import Menu from "../components/sections/Menu.astro";
import Snorkel from "../components/sections/Snorkel.astro";
import Footer from "../components/ui/Footer.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets"; 
import Rattan from "../assets/00562cRat.svg";
import Wasser from "../assets/Wasser.png";
---

<MainLayout
  title="Awatif Cafe"
  description="A Restaurant on Long Beach, Perhentian Kecil Island"
>

  <Menu />

  <!-- Wasser-Hintergrund beginnt hier -->
<section class="relative z-0 min-h-full bg-gradient-to-b from-[#ffff] to-[#bfdee6]">
  <!-- Hintergrund-Ebene, die sich an die Höhe des Inhalts anpasst -->
  <div class="absolute top-0 left-0 w-full h-full -z-10">
<img
  src={Wasser.src}
  alt="Water background"
  class="w-full h-full object-cover object-top opacity-20"
/>
  </div>

  <!-- Inhalt -->
  <WaterTaxi />
  <Snorkel />
  <Footer />
</section>
</MainLayout>