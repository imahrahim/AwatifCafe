---
const { sectionTitle, description } = Astro.props;
---

<div class="flex flex-col items-center gap-5 mb-10 sm:flex-row">
  <h2 class="greenhead text-center sm:text-left text-[50px] sm:text-4xl">{sectionTitle}</h2>
  <p class="w-auto text-justify sm:text-left sm:w-[580px]">
    {description}
  </p>
</div>
