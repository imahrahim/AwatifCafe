---
const { sectionTitle, description } = Astro.props;
---

<div class="flex flex-col items-left mb-4 sm:flex-row">
<h2 class="font-outline text-transparent text-left sm:text-left text-[4rem] ml-[-2.5rem] sm:text-4xl whitespace-nowrap">
  {sectionTitle}
</h2>
<p class="w-auto text-justify text-[#00562c] leading-tight mt-0 sm:text-left sm:w-[580px]">
  {description}
</p>
</div>
