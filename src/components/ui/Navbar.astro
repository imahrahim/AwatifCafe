---
const menuitems = [
  { href: "/#menu", label: "Menu" },
  { href: "/#watertaxi", label: "Water Taxi" },
  { href: "/#snorkel", label: "Snorkeling" },
];
---

<nav class="w-full fixed top-0 left-0 z-50 text-dark">
  <header class="flex items-center justify-between px-4 md:px-10 py-3 bg-transparent">
    <a href="/" class="flex items-center">
      <img src="/Logo.svg" alt="Awatif Cafe" class="h-8 w-auto" />
    </a>

    <ul class="flex items-center gap-4 md:gap-8 text-[13px] md:text-sm">
      {menuitems.map((item) => (
        <li>
          <a href={item.href} class="hover:underline whitespace-nowrap">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </header>
</nav>