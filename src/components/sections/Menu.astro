---
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";

const sectionTitle = "Menu";
const description = "Take a look at our full menu, which features everything from breakfast favourites to local specialities.";
---

<Section id="menu" noPadding={true}>

  <!-- Titelbereich mit Padding -->
  <div class="px-6 md:px-10 mt-[140px] mb-[40px]">
    <SectionTitle sectionTitle={sectionTitle} description={description} />
  </div>

  <!-- Menübilder Full Width -->
  <div class="menu">
    <img src="/menu/Beverages.webp" loading="lazy" class="w-full h-auto" />
    <img src="/menu/Breakfast.webp" loading="lazy" class="w-full h-auto" />
    <img src="/menu/Western.webp" loading="lazy" class="w-full h-auto" />
    <img src="/menu/Local.webp" loading="lazy" class="w-full h-auto" />
    <img src="/menu/Sayur.webp" loading="lazy" class="w-full h-auto" />
    <img src="/menu/Dessert.webp" loading="lazy" class="w-full h-auto" />
  </div>

</Section>