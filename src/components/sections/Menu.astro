---
import Accordion from "../ui/Accordion.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";
import awatifCafe from "../../assets/Awatif.svg";
import AwatifFull from "/public/AwatifFull.png";

const sectionTitle = "Awatif Cafe";
const description = "Discover our full menu, from breakfast favorites to local specialties.";
---

<Section id="process" noPadding={true}>
  <div class="relative w-full overflow-hidden">
    


    <!-- Text + Accordion (liegt über Bild) -->
<Section id="menu" noPadding={true}>
  <div class="w-full">
    <a href="/AwatifFull.png" target="_blank" rel="noopener noreferrer">
      <img
        src="/AwatifFull.png"
        alt="Awatif Cafe full menu"
        class="block w-full h-auto cursor-zoom-in"
      />
    </a>
  </div>

  </div>
</Section>